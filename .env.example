# Copy to .env.local for local dev. Vercel pulls its own values via
# `vercel env pull .env.local`.

# --- Database (Vercel-managed Neon Postgres) ----------------------------
DATABASE_URL=

# --- Auth (generated during `vercel:bootstrap` skill flow) --------------
AUTH_SECRET=

# --- Telegram bot (created via @BotFather; webhook points at Vercel) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_ID=

# --- Browser worker (Railway/Fly) — shared secret for worker→Vercel ----
WORKER_SHARED_SECRET=

# --- Reddit (optional, Research Agent only) -----------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=uteont-research/0.1
