# Copy to .env.local for local dev. Vercel pulls its own values via
# `vercel env pull .env.local`.

# --- Database (Vercel-managed Neon Postgres) ----------------------------
# Provisioned via `vercel integration add neon`. Pulled by `vercel env pull`.
DATABASE_URL=

# --- Auth (Vercel deployment protection assumed for user-facing UI) -----
# AUTH_SECRET is generated by the vercel:bootstrap flow.
AUTH_SECRET=

# --- Worker → API auth --------------------------------------------------
# Set the same value in Vercel (via `vercel env add`) and on the browser
# worker host (Railway/Fly/VPS). The middleware enforces this on all
# /api/jobs/* requests.
WORKER_SHARED_SECRET=

# --- Cron auth ----------------------------------------------------------
# Vercel sets this automatically for crons defined in vercel.json.
# Add it to your local env if you want to test /api/cron/* locally.
CRON_SECRET=

# --- Telegram bot (set up via @BotFather) -------------------------------
TELEGRAM_BOT_TOKEN=
# Secret token Telegram includes in X-Telegram-Bot-Api-Secret-Token header.
# You set this when registering the webhook with Telegram.
TELEGRAM_WEBHOOK_SECRET=
# Default chat ID for outbound notifications (your personal chat with the bot).
TELEGRAM_CHAT_ID=

# --- Reddit (optional, Research Agent only) -----------------------------
# Get from https://www.reddit.com/prefs/apps — pick "script" type.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=uteont-research/0.1

# --- DataForSEO (optional, Research Agent only — set on the WORKER) ------
# Real keyword search volume + competition + 12-month trend. Set on the worker
# host (Railway), NOT Vercel. Login/password from DataForSEO → Dashboard → API
# Access (login = your email; password = the API password shown there). Pay-as-
# you-go (~1-2¢ per seed); set a spend limit in their dashboard for safety.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_LOCATION_CODE=2840
DATAFORSEO_LANGUAGE_CODE=en
DATAFORSEO_LIMIT=30

# --- Secrets: encryption at rest ----------------------------------------
# 64-hex-char (32-byte) AES-256 key for encrypting site_integrations.config
# Generate locally:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED for the Google Search Console connection below (its refresh token is
# stored encrypted with this key).
CONNECTION_ENCRYPTION_KEY=

# --- Google Search Console (Performance Tracking agent) -----------------
# Pulls real clicks / impressions / CTR / position into the gsc_clicks +
# gsc_impressions target metrics. Setup (one-time):
#   1. Google Cloud Console → create an OAuth 2.0 Client ID (type: Web app).
#   2. Enable the "Google Search Console API" for that project.
#   3. Add this Authorized redirect URI (exact):
#        https://uteont.vercel.app/api/integrations/gsc/callback
#      (and http://localhost:3000/api/integrations/gsc/callback for local dev)
#   4. Put the client id/secret here AND set CONNECTION_ENCRYPTION_KEY above.
#   5. In the app: site → Integrations → "Connect Search Console".
# The agent + daily cron degrade gracefully (clear "not connected" note) until
# all of the above are set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Cost / model controls (Director + result dedup) --------------------
# GEMINI_API_KEY (see worker block below) is ALSO read by the Director on
# Vercel for planning calls. Override the Director's model here (default:
# gemini-flash-latest, free tier):
GEMINI_MODEL_DIRECTOR=
# Explicit Gemini context caching for the Director system prompt. "off"
# disables; unset/anything else enables with graceful fallback (free tier may
# reject cache creation — the Director degrades to an inline system prompt).
GEMINI_CONTEXT_CACHE=
# Result dedup: replay a finished agent result instead of re-running the worker
# when an identical request recurs. "off" disables; unset = on. Per-agent TTLs
# live in src/lib/services/result-cache.ts (research / idea-generation /
# backlink 7d, content-writing 30d, qa / seo-optimization disabled).
RESULT_DEDUP=

# --- Worker-only env (NOT used by Vercel) -------------------------------
# Set these in the worker's environment (Railway/Fly/VPS dashboard):
#   UTEONT_API_BASE=https://uteont.vercel.app
#   WORKER_SHARED_SECRET=<same value as above>
#   WORKER_ID=worker-1                            # optional, defaults to pid
#   WORKER_AGENTS=research,idea-generation,...    # optional, defaults to all worker agents
#   POLL_INTERVAL=5                                # seconds between empty polls
#
# LLM access for idea-generation / content-writing / outreach worker handlers.
# Get a free key at https://aistudio.google.com/app/apikey — free tier gives
# 1500 requests/day on gemini-2.5-flash, plenty for the UTEONT pipeline.
#   GEMINI_API_KEY=...
