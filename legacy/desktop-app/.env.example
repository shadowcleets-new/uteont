# Copy to .env and fill in. .env is git-ignored.

# --- Research Agent (all optional) ---------------------------------------

# Seed keywords for discovery. Comma-separated. If unset, defaults to:
#   ai tools, content marketing, seo strategy
# RESEARCH_SEED_KEYWORDS=

# Reddit (PRAW) credentials. If unset, the Reddit source is skipped silently
# and the agent uses Google Trends + Wikipedia only.
# Get them from https://www.reddit.com/prefs/apps (create a "script" app).
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=dna-seo-research/0.1
